# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used when running outside docker compose (compose overrides both).
DATABASE_URL=postgres://startup_scout:startup_scout@localhost:5433/startup_scout
REDIS_URL=redis://localhost:6380/0
